TELEGRAM_BOT_TOKEN=123456789:your_bot_token
TELEGRAM_CHAT_ID=-1001234567890

# check sources every N minutes
CHECK_INTERVAL_MINUTES=30

# max number of new posts for one cycle
MAX_POSTS_PER_CYCLE=2

# HTTP timeout for website parsing
REQUEST_TIMEOUT_SECONDS=15

# For educational video channel keep OFF (no IT filtering)
IT_ONLY=0

# keywords for topic filtering (used only when IT_ONLY=1)
TOPIC_KEYWORDS=имя прилагательное,2 класс,русский язык

# ===== YouTube lesson video filters =====
# keep only videos <= 15 minutes
YOUTUBE_MAX_DURATION_SECONDS=900
# all phrases below must be present in title/description
VIDEO_REQUIRED_PHRASES=имя прилагательное,2 класс

# yt-dlp mode (used for search + video download/upload)
YTDLP_ENABLED=1
# YTDLP_PATH=python -m yt_dlp

# Optional
# USER_AGENT=Mozilla/5.0 (compatible; TelegramAutoPostBot/1.0)
# SOURCES_FILE=./sources.json
# STATE_FILE=./state.json

# ===== Optional AI images (Nano Banana) =====
# Enable random AI image posting along with news posts
# ENABLE_AI_IMAGE_POSTS=1

# Probability (0..1) to generate image for each post
# AI_IMAGE_POST_CHANCE=0.2

# Nano Banana / OpenAI-like image API settings
# NANO_BANANA_API_URL=https://openrouter.ai/api/v1/images/generations
# NANO_BANANA_API_KEY=your_api_key_here
# NANO_BANANA_MODEL=google/gemini-2.5-flash-image-preview
# AI_IMAGE_SIZE=1024x1024
# AI_IMAGE_STYLE_PROMPT=clean modern IT illustration, channel logo concept, vector style, bright contrast, no watermark, no readable text

# ===== Optional link encryption in posts =====
# LINK_ENCRYPTION_ENABLED=0
# LINK_ENCRYPTION_KEY=change_me_secret_key
