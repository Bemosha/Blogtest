TELEGRAM_BOT_TOKEN=123456789:your_bot_token

# Optional AI generation (for much higher quality and unique 3D games)
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4.1-mini
AI_TIMEOUT_SECONDS=120

# GitHub настройки ОПЦИОНАЛЬНЫ.
# Если не заполнять, бот всё равно работает:
# - генерирует игру
# - отправляет index.html файлом в Telegram
# - сохраняет локально в generated_games/

# GitHub personal access token with repo write access (optional)
GITHUB_TOKEN=

# GitHub repository where generated games will be saved (optional)
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_BRANCH=main

# Path in repository where game folders will be created
GAMES_BASE_PATH=generated_games

# Optional: if you have GitHub Pages or custom hosting, set base URL
# Example: https://yourname.github.io/your_repo
# GAME_LINK_BASE=https://yourname.github.io/your_repo
